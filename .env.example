# Server & Network
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Database & Security
# Local Docker Compose DB: postgresql://postgres:postgrespassword@localhost:5432/stackhr_dev?schema=public
# Local Docker Compose Test DB: postgresql://postgres:postgrespassword@localhost:5432/stackhr_test?schema=public
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/stackhr_dev?schema=public
ENCRYPTION_KEY=development-secret-encryption-key-32b
AUTH_SECRET=development-auth-secret-key-32b

# Email & Notifications (SendByte)
SENDBYTE_API_KEY=
SENDBYTE_KEY=
SENDBYTE_FROM_EMAIL=StackHR <noreply@stackhr.app>

# Optional first StackHR platform administrator bootstrap.
# If set, the account is created on startup when it does not already exist.
STACKHR_ADMIN_EMAIL=
STACKHR_ADMIN_PASSWORD=
STACKHR_ADMIN_NAME=StackHR Admin

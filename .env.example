# ==============================================================================
# StackHR Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and provide the necessary credentials.
# Variables marked [REQUIRED] must be set for the application to function properly.
# Variables marked [OPTIONAL] have sensible fallbacks or can be left blank in dev.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server, Network & CORS Configuration
# ------------------------------------------------------------------------------
# [OPTIONAL] Port on which the NestJS HTTP server listens (default: 3001)
PORT=3001

# [OPTIONAL] Host IP to bind server process (default: 0.0.0.0)
HOST=0.0.0.0

# [OPTIONAL] Environment mode: 'development' | 'test' | 'production' (default: development)
NODE_ENV=development

# [OPTIONAL] Pino logger minimum severity: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'
# Defaults to 'debug' in development, 'info' in production
LOG_LEVEL=debug

# [REQUIRED] Comma-separated list of allowed frontend origins for CORS and invite URLs
FRONTEND_URL="http://localhost:3000,http://localhost:5173"

# [OPTIONAL] Cookie SameSite policy: 'Lax' | 'Strict' | 'None' (default: Lax in dev, None in prod)
COOKIE_SAMESITE=None

# [OPTIONAL] Set to true if cookies must only be transmitted over HTTPS (required if SameSite=None)
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 2. Database & Security
# ------------------------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string.
# - Local Docker Compose: postgresql://postgres:postgrespassword@localhost:5432/stackhr_dev?schema=public
# - Neon Serverless: postgresql://<user>:<password>@<host>/neondb?sslmode=require&connect_timeout=30
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/stackhr_dev?schema=public"

# [REQUIRED] Secret key used for signing session tokens and hashing verification codes (min 32 chars)
AUTH_SECRET="development-auth-secret-key-32b-min"

# [REQUIRED] 32-character AES-256-GCM symmetric key for field-level encryption of sensitive data
ENCRYPTION_KEY="development-secret-encryption-key-32b"

# [OPTIONAL] Dedicated encryption key for payment rails / banking credentials
PAYMENT_ENCRYPTION_KEY="development-payment-secret-key-32b"

# ------------------------------------------------------------------------------
# 3. Email & Notifications (SendByte Gateway)
# ------------------------------------------------------------------------------
# [OPTIONAL in dev, REQUIRED in prod] SendByte API key for transactional emails
SENDBYTE_API_KEY=""

# [OPTIONAL] Default sender name and email address
SENDBYTE_FROM_EMAIL="StackHR <noreply@stackhr.app>"

# [OPTIONAL] SendByte Brand UUID for audience lists
SENDBYTE_BRAND_ID=""

# [OPTIONAL] SendByte List UUID for syncing public waitlist registrations
SENDBYTE_WAITLIST_LIST_ID=""

# ------------------------------------------------------------------------------
# 4. Web Application Branding & URL Overrides
# ------------------------------------------------------------------------------
# [OPTIONAL] Base URL of the live frontend app (used for password reset & invitation links)
# Defaults to https://app.stackhr.app if omitted
STACKHR_APP_URL="http://localhost:5173"

# [OPTIONAL] Support email address embedded in transactional email footers
STACKHR_SUPPORT_EMAIL="support@stackhr.app"

# ------------------------------------------------------------------------------
# 5. Initial Platform Administrator Bootstrap (Optional)
# ------------------------------------------------------------------------------
# If set, a root StackHR platform admin account is automatically created on startup
# if no user exists with this email address.
STACKHR_ADMIN_EMAIL=""
STACKHR_ADMIN_PASSWORD=""
STACKHR_ADMIN_NAME="StackHR Admin"

# ------------------------------------------------------------------------------
# 6. File & Document Storage (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# [OPTIONAL in local dev, REQUIRED for employee document uploads & payslip PDFs]
S3_BUCKET="stackhr"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# R2 endpoint format: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""

# Set to 'true' for local MinIO/S3-compatible emulators; 'false' for Cloudflare R2 & AWS S3
S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# 7. Nigerian Statutory Pension Remittance (PenCentral Partner API)
# ------------------------------------------------------------------------------
# [OPTIONAL in dev, REQUIRED for pension schedule submissions & validation]
PENCENTRAL_BASE_URL="https://newhrpartnersapi.pensioncentral.ng"
PENCENTRAL_API_KEY=""
PENCENTRAL_ENVIRONMENT="sandbox"

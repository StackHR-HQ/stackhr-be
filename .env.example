PORT=3001
HOST=0.0.0.0
# Optional extra CORS origins, comma-separated. The backend always permits
# http://localhost:3000, http://localhost:5173, and https://app.stackhr.app.
FRONTEND_URL=

DATABASE_URL=
# Use the `sk_test_` key while developing; it simulates delivery without
# requiring domain verification. Replace it with `sk_live_` after verification.
SENDBYTE_API_KEY=
# Must be in `Name <email@your-verified-domain>` format for live sends.
SENDBYTE_FROM_EMAIL=StackHR <noreply@stackhr.app>
STACKHR_APP_URL=https://app.stackhr.app
STACKHR_SUPPORT_EMAIL=support@stackhr.app

# Cloudflare R2 document storage. Create a bucket-scoped R2 API token with
# Object Read & Write permission, then use its S3 API credentials here.
# R2 endpoint format: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional first StackHR platform administrator bootstrap.
# If set, the account is created on startup when it does not already exist.
STACKHR_ADMIN_EMAIL=
STACKHR_ADMIN_PASSWORD=
STACKHR_ADMIN_NAME=StackHR Admin
